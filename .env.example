# ==================================================
# BADYSS — Environment Variables (EXAMPLE ONLY)
# ==================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
#
# All WordPress/WooCommerce credentials must only be used
# server-side (Route Handlers, Server Components, Server Actions).
# Never prefix secret values with NEXT_PUBLIC_.

# WordPress site base URL (headless CMS backend, hosted on Hostinger)
WORDPRESS_URL=

# WooCommerce REST API credentials (server-side only, never exposed to the browser)
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Public site URL for the Next.js frontend (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=

# Real BADYSS WhatsApp Business number, international format (e.g. 2126XXXXXXXX),
# no "+" or spaces. Leave empty until confirmed — the floating WhatsApp button
# and every WhatsApp CTA on the site simply don't render without a real number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
